# Airflow Core Settings
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=True

# Disable Astronomer Update Check (fixes KeyError)
AIRFLOW__ASTRONOMER__UPDATE_CHECK_INTERVAL=0
ASTRONOMER__UPDATE_CHECK__ENABLED=False

# Database
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/postgres